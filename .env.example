APP_NAME="Maya Cosméticos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SITE_URL=https://mayacosmeticos.com.br

APP_LOCALE=pt-br
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# CONFIGS
SITE_EMAIL_DEV=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# DEVELOPMENT
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#PIX
PIX_PSP_CLIENT_SECRET=
PIX_PSP_CLIENT_ID=
PIX_PSP_CERT=
PIX_PSP_SANDBOX=true
PIX_PSP_PIXKEY=
PIX_EXPIRATION=1800

#PAYMENT NOTIFICATION (EFÍ)
EFI_PAYMENT_NOTIFICATION_URL=

MAILCHIMP_DRIVER=Spatie\Newsletter\Drivers\MailChimpDriver::class
MAILCHIMP_LIST_ID=
MAILCHIMP_APIKEY=

FILE_MAX_QTDE=6
FILE_MAX_FILE_SIZE_TXT=5MB
FILE_DESTINATION_PRODUCTS='img/products/'
FILE_DESTINATION_CATEGORIES='img/categories/'
FILE_DESTINATION_BRANDS='img/brands/'
FILE_DESTINATION_SUPPLIERS='img/suppliers/'
FILE_DESTINATION_PARTNERS='img/partners/'
